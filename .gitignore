## ========================================================
## CampusBook - University Book Exchange System
## .gitignore for ASP.NET Core, C#, EF Core & SQL Server
## ========================================================

# ---------------------------------------------------------
# Build Results & Artifacts
# ---------------------------------------------------------
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
[Pp]ublish/
publish/
artifacts/

# ---------------------------------------------------------
# Visual Studio / Visual Studio Code / JetBrains Rider
# ---------------------------------------------------------
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.pidb
*.booproj
*.svclog

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains Rider & ReSharper
.idea/
*.DotSettings.user
_ReSharper*/

# ---------------------------------------------------------
# Sensitive Configurations, Credentials & Secrets
# ---------------------------------------------------------
# ASP.NET Core User Secrets folder
**/UserSecrets/
secrets.json

# Environment and sensitive production settings
*.env
*.env.*
.env
appsettings.Production.json
appsettings.Local.json
*.local.json

# ---------------------------------------------------------
# User Uploads & Media (Privacy & Vulnerability Protection)
# Never commit real user uploads (student IDs, avatars, photos)
# ---------------------------------------------------------
**/wwwroot/uploads/**
!**/wwwroot/uploads/
!**/wwwroot/uploads/**/
!**/wwwroot/uploads/**/.gitkeep

# ---------------------------------------------------------
# Database, LocalDB & SQL Server Files
# Prevent leaking local database files and backups
# ---------------------------------------------------------
*.mdf
*.ldf
*.ndf
*.bak
*.dacpac
*.dbschema
App_Data/*.mdf
App_Data/*.ldf

# ---------------------------------------------------------
# Test Results & Code Coverage
# ---------------------------------------------------------
TestResults/
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml
coverage/
coveragereport/

# ---------------------------------------------------------
# NuGet Packages & Caches
# ---------------------------------------------------------
*.nuget.props
*.nuget.targets
packages/
*.nupkg
project.lock.json
project.fragment.lock.json

# ---------------------------------------------------------
# Temporary & Diagnostic Files
# ---------------------------------------------------------
*.log
*.tmp
*~
*.swp
*.bak
*.orig

# ---------------------------------------------------------
# Operating System Files
# ---------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory
.Trash-*

# ---------------------------------------------------------
# Agent / Scratch Artifacts
# ---------------------------------------------------------
.system_generated/
scratch/

@model WishlistPageViewModel
@{
    ViewData["Title"] = "My Saved Books (Wishlist)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">My Wishlist 💖</h1>
        <p class="text-muted small mb-0">Textbooks you have bookmarked to monitor availability and acquire later.</p>
    </div>
    <a asp-controller="Books" asp-action="Index" class="btn btn-campus-outline btn-sm">
        Browse Catalogue &rarr;
    </a>
</div>

@if (!Model.Items.Any())
{
    <div class="card card-campus text-center py-5 border-0 shadow-sm">
        <div class="card-body">
            <span class="fs-1 d-inline-block mb-2">🤍</span>
            <h2 class="h5 fw-bold mb-2">Your Wishlist is Empty</h2>
            <p class="text-muted small mb-4">You have not saved any books yet. Browse the campus catalogue and save books you need for upcoming semesters!</p>
            <a asp-controller="Books" asp-action="Index" class="btn btn-campus px-4 py-2">
                Explore Available Books
            </a>
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
        @foreach (var item in Model.Items)
        {
            <div class="col">
                <div class="card card-campus h-100 shadow-sm d-flex flex-column border">
                    <div class="book-cover-container position-relative">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Title" class="book-cover-img" />
                        }
                        else
                        {
                            <div class="book-cover-placeholder">
                                <span class="fs-2">📖</span>
                                <span class="small">No Cover Image</span>
                            </div>
                        }
                        <div class="position-absolute top-0 end-0 m-2">
                            <span class="badge @(item.ExchangeType == ExchangeType.Sale ? "badge-type-sale" : "badge-type-exchange")">
                                @item.ExchangeType
                            </span>
                        </div>
                    </div>

                    <div class="card-body p-3 d-flex flex-column flex-grow-1">
                        <div class="mb-1 d-flex justify-content-between align-items-center">
                            <span class="badge @(item.Condition switch {
                                BookCondition.New => "badge-condition-new",
                                BookCondition.Good => "badge-condition-good",
                                BookCondition.Fair => "badge-condition-fair",
                                _ => "badge-condition-poor"
                            })">@item.Condition</span>
                            
                            <span class="badge @(item.Status switch {
                                BookStatus.Available => "badge-status-available",
                                BookStatus.Reserved => "badge-status-reserved",
                                BookStatus.Completed => "badge-status-completed",
                                _ => "badge-status-inactive"
                            })">@item.Status</span>
                        </div>

                        <h2 class="h6 fw-bold mb-1 text-truncate mt-1" title="@item.Title">
                            <a asp-controller="Books" asp-action="Details" asp-route-id="@item.BookId" class="text-dark text-decoration-none">
                                @item.Title
                            </a>
                        </h2>
                        <p class="small text-muted mb-2 text-truncate">by @item.Author</p>

                        <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                            <span class="fw-bold fs-6 text-primary">@item.Price.ToPriceText()</span>
                            
                            <div class="d-flex gap-2">
                                <a asp-controller="Books" asp-action="Details" asp-route-id="@item.BookId" class="btn btn-sm btn-campus-outline">
                                    Details
                                </a>
                                <form asp-action="Remove" method="post" onsubmit="return confirm('Remove this book from your wishlist?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookId" value="@item.BookId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove from wishlist">
                                        ✕
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-light px-3 py-2 text-muted small d-flex justify-content-between">
                        <span class="text-truncate">Owner: <strong>@item.OwnerName</strong></span>
                        <span>Saved @item.AddedAt.ToDateText()</span>
                    </div>
                </div>
            </div>
        }
    </div>
}

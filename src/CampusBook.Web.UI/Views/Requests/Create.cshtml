@model CreateRequestViewModel
@{
    ViewData["Title"] = $"Request Book - {Model.BookTitle}";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <div class="card card-campus shadow-sm">
            <div class="card-header bg-white p-4 border-bottom">
                <h1 class="h4 fw-bold mb-1">Request Book</h1>
                <p class="text-muted small mb-0">Send a formal request to the student book owner</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <!-- Book Summary Banner -->
                <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-3 border mb-4">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.BookTitle" style="width: 60px; height: 80px; object-fit: cover; border-radius: 4px;" />
                    }
                    else
                    {
                        <div class="bg-white border text-muted d-flex align-items-center justify-content-center" style="width: 60px; height: 80px; border-radius: 4px;">
                            📖
                        </div>
                    }
                    <div>
                        <span class="badge @(Model.ExchangeType switch {
                            ExchangeType.Donation => "badge-type-donation",
                            ExchangeType.Sale => "badge-type-sale",
                            _ => "badge-type-exchange"
                        }) mb-1">@Model.ExchangeType</span>
                        <h2 class="h6 fw-bold mb-1">@Model.BookTitle</h2>
                        <div class="small text-muted">by @Model.BookAuthor &bull; Listed by <strong>@Model.OwnerName</strong></div>
                        <div class="fw-bold text-primary small mt-1">@Model.Price.ToPriceText()</div>
                    </div>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="BookId" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-4"></div>

                    @if (Model.ExchangeType == ExchangeType.Exchange)
                    {
                        <div class="card border-primary-subtle bg-light mb-4">
                            <div class="card-body">
                                <h3 class="h6 fw-bold text-primary mb-2">🔄 Book-for-Book Exchange Option</h3>
                                <p class="small text-muted mb-3">The owner has offered this textbook for trade. Please select one of your available books to offer in exchange:</p>

                                @if (!Model.UserAvailableBooks.Any())
                                {
                                    <div class="alert alert-warning small mb-0">
                                        ⚠️ You do not have any available books in your account to offer in trade.
                                        Please <a asp-controller="Books" asp-action="Create" class="fw-bold">publish an available book first</a> before requesting a trade.
                                    </div>
                                }
                                else
                                {
                                    <div class="mb-2">
                                        <label asp-for="OfferedBookId" class="form-label"></label>
                                        <select asp-for="OfferedBookId" class="form-select" asp-items="Model.UserAvailableBooks">
                                            <option value="">-- Choose a book you own to trade --</option>
                                        </select>
                                        <span asp-validation-for="OfferedBookId" class="text-danger small"></span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="mb-4">
                        <label asp-for="RequestMessage" class="form-label"></label>
                        <textarea asp-for="RequestMessage" class="form-control" rows="4" placeholder="Hello! I am taking this course this term and would love to arrange a convenient handover on campus (e.g. at the Student Union or Library)..."></textarea>
                        <span asp-validation-for="RequestMessage" class="text-danger small"></span>
                        <small class="text-muted">Include your preferred meetup times or campus locations.</small>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-campus px-4 py-2" @(Model.ExchangeType == ExchangeType.Exchange && !Model.UserAvailableBooks.Any() ? "disabled" : "")>
                            Submit Book Request
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


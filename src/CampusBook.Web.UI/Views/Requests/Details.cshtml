@model RequestDetailsViewModel
@{
    ViewData["Title"] = $"Request #{Model.RequestId} - {Model.BookTitle}";
}

<div class="row mb-3">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small">
                @if (Model.IsOwner)
                {
                    <li class="breadcrumb-item"><a asp-action="Received">Requests for My Books</a></li>
                }
                else
                {
                    <li class="breadcrumb-item"><a asp-action="Sent">My Sent Requests</a></li>
                }
                <li class="breadcrumb-item active" aria-current="page">Request #@Model.RequestId</li>
            </ol>
        </nav>
    </div>
</div>

<div class="card card-campus shadow-sm p-4 p-md-5 mb-5 border-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 border-bottom pb-3 mb-4">
        <div>
            <div class="text-muted small">
                @(Model.ExchangeType == ExchangeType.Exchange ? "Book-for-Book Exchange" : "Sale Request") #@Model.RequestId &bull; Submitted @Model.CreatedAt.ToDateTimeText()
            </div>
            <h1 class="h4 fw-bold mb-0">@Model.BookTitle</h1>
        </div>
        <div>
            <span class="badge fs-6 px-3 py-2 @(Model.Status switch {
                RequestStatus.Pending => "badge-request-pending",
                RequestStatus.Accepted => "badge-request-accepted",
                RequestStatus.Rejected => "badge-request-rejected",
                RequestStatus.Cancelled => "badge-request-cancelled",
                RequestStatus.Completed => "badge-request-completed",
                _ => "bg-secondary"
            })">@Model.Status</span>
        </div>
    </div>

    <!-- Handover Progress & Messaging Toolbar (When Accepted or Completed) -->
    @if (Model.Status == RequestStatus.Accepted || Model.Status == RequestStatus.Completed)
    {
        <div class="card bg-light border-primary-subtle mb-4">
            <div class="card-body p-4">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                    <h2 class="h6 fw-bold text-primary mb-0">🤝 Physical Handover & Exchange Coordination</h2>
                    @if (Model.ConversationId.HasValue)
                    {
                        <a asp-controller="Messages" asp-action="Conversation" asp-route-id="@Model.ConversationId.Value" class="btn btn-sm btn-primary px-3 shadow-sm">
                            💬 Open Chat with @(Model.IsOwner ? Model.RequesterName : Model.OwnerName)
                        </a>
                    }
                </div>

                @if (Model.Status == RequestStatus.Accepted)
                {
                    <p class="small text-muted mb-3">
                        This request is accepted and the book is reserved. Use the in-app chat above to arrange a time and place to meet on campus. Once completed, both students must confirm below:
                    </p>
                }
                else
                {
                    <div class="alert alert-success py-2 small mb-3">
                        🎉 Transaction Completed! Both parties have confirmed the handover.
                    </div>
                }

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 bg-white rounded border d-flex justify-content-between align-items-center">
                            <div>
                                <span class="small text-muted d-block">Book Owner (@Model.OwnerName)</span>
                                <strong>@(Model.OwnerConfirmed ? "✓ Handover Confirmed" : "⏳ Awaiting Confirmation")</strong>
                                @if (Model.OwnerConfirmedAt.HasValue)
                                {
                                    <div class="small text-muted">@Model.OwnerConfirmedAt.Value.ToDateTimeText()</div>
                                }
                            </div>
                            @if (Model.IsOwner && !Model.OwnerConfirmed && Model.Status == RequestStatus.Accepted)
                            {
                                <form asp-action="ConfirmHandover" asp-route-id="@Model.RequestId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success">Confirm Handover</button>
                                </form>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-white rounded border d-flex justify-content-between align-items-center">
                            <div>
                                <span class="small text-muted d-block">Requesting Student (@Model.RequesterName)</span>
                                <strong>@(Model.RequesterConfirmed ? "✓ Receipt Confirmed" : "⏳ Awaiting Confirmation")</strong>
                                @if (Model.RequesterConfirmedAt.HasValue)
                                {
                                    <div class="small text-muted">@Model.RequesterConfirmedAt.Value.ToDateTimeText()</div>
                                }
                            </div>
                            @if (Model.IsRequester && !Model.RequesterConfirmed && Model.Status == RequestStatus.Accepted)
                            {
                                <form asp-action="ConfirmHandover" asp-route-id="@Model.RequestId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success">Confirm Receipt</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Comparison / Details Row -->
    <div class="row g-4 mb-4">
        <!-- Requested Book Column -->
        <div class="col-md-6">
            <div class="card h-100 border">
                <div class="card-header bg-white fw-bold">Requested Book</div>
                <div class="card-body">
                    <div class="d-flex gap-3 mb-3">
                        @if (!string.IsNullOrEmpty(Model.BookImageUrl))
                        {
                            <img src="@Model.BookImageUrl" alt="@Model.BookTitle" style="width: 75px; height: 100px; object-fit: cover; border-radius: 4px;" />
                        }
                        else
                        {
                            <div class="bg-light text-muted d-flex align-items-center justify-content-center" style="width: 75px; height: 100px; border-radius: 4px;">
                                📖
                            </div>
                        }
                        <div>
                            <h3 class="h6 fw-bold mb-1">
                                <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" class="text-dark text-decoration-none">@Model.BookTitle</a>
                            </h3>
                            <div class="small text-muted mb-1">by @Model.BookAuthor</div>
                            <span class="badge @(Model.ExchangeType == ExchangeType.Sale ? "badge-type-sale" : "badge-type-exchange")">
                                @Model.ExchangeType
                            </span>
                            <div class="fw-bold text-primary small mt-1">@Model.Price.ToPriceText()</div>
                        </div>
                    </div>
                    <div class="small text-muted">
                        Listed by: <strong>@Model.OwnerName</strong> (@Model.OwnerDepartment)
                    </div>
                </div>
            </div>
        </div>

        <!-- Offered in Return Column -->
        <div class="col-md-6">
            <div class="card h-100 border">
                <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                    <span>Offered in Return</span>
                    @if (Model.ExchangeOffer != null)
                    {
                        <span class="badge badge-type-exchange">Trade Offer</span>
                    }
                </div>
                <div class="card-body">
                    @if (Model.ExchangeOffer != null)
                    {
                        <div class="d-flex gap-3 mb-3">
                            @if (!string.IsNullOrEmpty(Model.ExchangeOffer.ImageUrl))
                            {
                                <img src="@Model.ExchangeOffer.ImageUrl" alt="@Model.ExchangeOffer.Title" style="width: 75px; height: 100px; object-fit: cover; border-radius: 4px;" />
                            }
                            else
                            {
                                <div class="bg-light text-muted d-flex align-items-center justify-content-center" style="width: 75px; height: 100px; border-radius: 4px;">
                                    🔄
                                </div>
                            }
                            <div>
                                <h3 class="h6 fw-bold mb-1">@Model.ExchangeOffer.Title</h3>
                                <div class="small text-muted mb-1">by @Model.ExchangeOffer.Author</div>
                                <span class="badge bg-secondary">Condition: @Model.ExchangeOffer.Condition</span>
                                <span class="small text-muted ms-1">&bull; @Model.ExchangeOffer.CategoryName</span>
                            </div>
                        </div>

                        <ul class="list-group list-group-flush small mb-3">
                            @if (!string.IsNullOrEmpty(Model.ExchangeOffer.Isbn))
                            {
                                <li class="list-group-item px-0 py-1 d-flex justify-content-between">
                                    <span class="text-muted">ISBN:</span>
                                    <span>@Model.ExchangeOffer.Isbn</span>
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(Model.ExchangeOffer.Edition))
                            {
                                <li class="list-group-item px-0 py-1 d-flex justify-content-between">
                                    <span class="text-muted">Edition:</span>
                                    <span>@Model.ExchangeOffer.Edition</span>
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(Model.ExchangeOffer.CourseCode))
                            {
                                <li class="list-group-item px-0 py-1 d-flex justify-content-between">
                                    <span class="text-muted">Course Code:</span>
                                    <span>@Model.ExchangeOffer.CourseCode</span>
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(Model.ExchangeOffer.DepartmentName))
                            {
                                <li class="list-group-item px-0 py-1 d-flex justify-content-between">
                                    <span class="text-muted">Department:</span>
                                    <span>@Model.ExchangeOffer.DepartmentName</span>
                                </li>
                            }
                        </ul>

                        <div class="small mb-2">
                            <strong>Description:</strong>
                            <p class="text-secondary mb-1">@Model.ExchangeOffer.Description</p>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ExchangeOffer.Notes))
                        {
                            <div class="small alert alert-warning py-1 px-2 mb-0">
                                <strong>Condition Notes:</strong> @Model.ExchangeOffer.Notes
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small p-4 text-center">
                            Sale transaction: @Model.Price.ToPriceText() payable upon campus meetup.
                        </div>
                    }

                    <div class="small text-muted mt-3 border-top pt-2">
                        Requester: <strong>@Model.RequesterName</strong> &bull; @Model.RequesterDepartment (@Model.RequesterBatch)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Request Message -->
    @if (!string.IsNullOrEmpty(Model.RequestMessage))
    {
        <div class="mb-4">
            <h2 class="h6 fw-bold text-uppercase text-muted border-bottom pb-2 mb-2">Message from Requester</h2>
            <div class="p-3 bg-light rounded border text-secondary" style="white-space: pre-line;">
                @Model.RequestMessage
            </div>
        </div>
    }

    <!-- Bottom Actions Toolbar -->
    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
        @if (Model.IsOwner)
        {
            <a asp-action="Received" class="btn btn-outline-secondary">&larr; Back to Received Requests</a>

            @if (Model.Status == RequestStatus.Pending)
            {
                <div class="d-flex gap-2">
                    <form asp-action="Reject" asp-route-id="@Model.RequestId" method="post" onsubmit="return confirm('Are you sure you want to decline this request?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger">Decline Request</button>
                    </form>
                    <form asp-action="Accept" asp-route-id="@Model.RequestId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success px-4">Accept Request & Reserve Book</button>
                    </form>
                </div>
            }
        }
        else
        {
            <a asp-action="Sent" class="btn btn-outline-secondary">&larr; Back to Sent Requests</a>

            @if (Model.Status == RequestStatus.Pending)
            {
                <form asp-action="Cancel" asp-route-id="@Model.RequestId" method="post" onsubmit="return confirm('Are you sure you want to cancel this request?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">Cancel Request</button>
                </form>
            }
        }
    </div>
</div>

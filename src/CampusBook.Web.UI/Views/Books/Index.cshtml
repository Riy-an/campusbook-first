@model BookFilterViewModel
@{
    ViewData["Title"] = "Academic Book Catalogue";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h1 class="h3 fw-bold mb-1">University Book Exchange Catalogue</h1>
                <p class="text-muted small mb-0">Browse academic textbooks, course materials, and study guides shared by university students.</p>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-action="Create" class="btn btn-campus d-inline-flex align-items-center gap-2">
                    <span>+</span> Publish a Book
                </a>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Filters Sidebar -->
    <div class="col-lg-3">
        <div class="card card-campus shadow-sm p-3">
            <h2 class="h6 fw-bold mb-3 border-bottom pb-2">Search & Filters</h2>

            <form method="get" asp-action="Index">
                <!-- Search Keyword -->
                <div class="mb-3">
                    <label class="form-label small">Search</label>
                    <input type="text" name="SearchTerm" class="form-control form-control-sm" placeholder="Title, author, ISBN..." value="@Model.SearchTerm" />
                </div>

                <!-- Category -->
                <div class="mb-3">
                    <label class="form-label small">Category</label>
                    <select name="CategoryId" class="form-select form-select-sm" asp-items="Model.Categories">
                        <option value="">All Categories</option>
                    </select>
                </div>

                <!-- Department -->
                <div class="mb-3">
                    <label class="form-label small">Department</label>
                    <select name="DepartmentId" class="form-select form-select-sm" asp-items="Model.Departments">
                        <option value="">All Departments</option>
                    </select>
                </div>

                <!-- Condition -->
                <div class="mb-3">
                    <label class="form-label small">Condition</label>
                    <select name="Condition" class="form-select form-select-sm">
                        <option value="">All Conditions</option>
                        <option value="New" selected="@(Model.Condition == BookCondition.New)">New</option>
                        <option value="Good" selected="@(Model.Condition == BookCondition.Good)">Good</option>
                        <option value="Fair" selected="@(Model.Condition == BookCondition.Fair)">Fair</option>
                        <option value="Poor" selected="@(Model.Condition == BookCondition.Poor)">Poor</option>
                    </select>
                </div>

                <!-- Exchange Type -->
                <div class="mb-3">
                    <label class="form-label small">Listing Type</label>
                    <select name="ExchangeType" class="form-select form-select-sm">
                        <option value="">All Types</option>
                        <option value="Sale" selected="@(Model.ExchangeType == ExchangeType.Sale)">For Sale</option>
                        <option value="Exchange" selected="@(Model.ExchangeType == ExchangeType.Exchange)">Book Exchange</option>
                    </select>
                </div>

                <!-- Price Range -->
                <div class="mb-3">
                    <label class="form-label small">Price Range (৳)</label>
                    <div class="input-group input-group-sm mb-1">
                        <span class="input-group-text">৳</span>
                        <input type="number" step="0.5" name="MinPrice" class="form-control" placeholder="Min" value="@Model.MinPrice" />
                        <span class="input-group-text">to</span>
                        <input type="number" step="0.5" name="MaxPrice" class="form-control" placeholder="Max" value="@Model.MaxPrice" />
                    </div>
                </div>

                <!-- Sort Order -->
                <div class="mb-4">
                    <label class="form-label small">Sort By</label>
                    <select name="SortBy" class="form-select form-select-sm">
                        <option value="newest" selected="@(Model.SortBy == "newest")">Newest Listings</option>
                        <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Lowest Price</option>
                        <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Highest Price</option>
                        <option value="title" selected="@(Model.SortBy == "title")">Book Title (A-Z)</option>
                    </select>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-campus btn-sm">Apply Filters</button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Book Grid & Pagination -->
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted small">Showing <strong>@(Model.Books?.Items.Count ?? 0)</strong> of <strong>@(Model.Books?.TotalCount ?? 0)</strong> available books</span>
        </div>

        @if (Model.Books == null || !Model.Books.Items.Any())
        {
            <div class="card card-campus shadow-sm p-5 text-center text-muted">
                <span class="fs-1 mb-2">🔍</span>
                <h3 class="h5 fw-bold text-dark mb-1">No Books Found</h3>
                <p class="small mb-3">No available books match your search and filter criteria. Try adjusting your search term or filters.</p>
                <div>
                    <a asp-action="Index" class="btn btn-sm btn-campus">Clear Filters</a>
                </div>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                @foreach (var book in Model.Books.Items)
                {
                    <div class="col">
                        <div class="card card-campus h-100 shadow-sm d-flex flex-column">
                            <div class="book-cover-container">
                                @if (!string.IsNullOrEmpty(book.ImageUrl))
                                {
                                    <img src="@book.ImageUrl" alt="@book.Title" class="book-cover-img" />
                                }
                                else
                                {
                                    <div class="book-cover-placeholder">
                                        <span class="fs-2">📖</span>
                                        <span class="small">No Cover Image</span>
                                    </div>
                                }
                                <div class="position-absolute top-0 end-0 m-2">
                                    <span class="badge @(book.ExchangeType switch {
                                        ExchangeType.Donation => "badge-type-donation",
                                        ExchangeType.Sale => "badge-type-sale",
                                        _ => "badge-type-exchange"
                                    })">@book.ExchangeType</span>
                                </div>
                            </div>

                            <div class="card-body p-3 d-flex flex-column flex-grow-1">
                                <div class="mb-1">
                                    <span class="badge @(book.Condition switch {
                                        BookCondition.New => "badge-condition-new",
                                        BookCondition.Good => "badge-condition-good",
                                        BookCondition.Fair => "badge-condition-fair",
                                        _ => "badge-condition-poor"
                                    })">@book.Condition</span>
                                    <span class="text-muted small ms-1 text-truncate">&bull; @book.CategoryName</span>
                                </div>

                                <h2 class="h6 fw-bold mb-1 text-truncate" title="@book.Title">
                                    <a asp-action="Details" asp-route-id="@book.BookId" class="text-dark text-decoration-none">@book.Title</a>
                                </h2>
                                <p class="small text-muted mb-2 text-truncate">by @book.Author</p>

                                <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                    <span class="fw-bold fs-6 text-primary">@book.Price.ToPriceText()</span>
                                    <a asp-action="Details" asp-route-id="@book.BookId" class="btn btn-sm btn-campus-outline">Details</a>
                                </div>
                            </div>
                            <div class="card-footer bg-light px-3 py-2 text-muted small d-flex justify-content-between">
                                <span class="text-truncate">Owner: <strong>@book.OwnerName</strong></span>
                                <span>@book.CreatedAt.ToDateText()</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.Books.TotalPages > 1)
            {
                <nav class="mt-5" aria-label="Book catalogue pagination">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(!Model.Books.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-CategoryId="@Model.CategoryId"
                               asp-route-DepartmentId="@Model.DepartmentId"
                               asp-route-Condition="@Model.Condition"
                               asp-route-ExchangeType="@Model.ExchangeType"
                               asp-route-MinPrice="@Model.MinPrice"
                               asp-route-MaxPrice="@Model.MaxPrice"
                               asp-route-SortBy="@Model.SortBy"
                               asp-route-PageIndex="@(Model.Books.PageIndex - 1)">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.Books.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Books.PageIndex ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-SearchTerm="@Model.SearchTerm"
                                   asp-route-CategoryId="@Model.CategoryId"
                                   asp-route-DepartmentId="@Model.DepartmentId"
                                   asp-route-Condition="@Model.Condition"
                                   asp-route-ExchangeType="@Model.ExchangeType"
                                   asp-route-MinPrice="@Model.MinPrice"
                                   asp-route-MaxPrice="@Model.MaxPrice"
                                   asp-route-SortBy="@Model.SortBy"
                                   asp-route-PageIndex="@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(!Model.Books.HasNextPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-CategoryId="@Model.CategoryId"
                               asp-route-DepartmentId="@Model.DepartmentId"
                               asp-route-Condition="@Model.Condition"
                               asp-route-ExchangeType="@Model.ExchangeType"
                               asp-route-MinPrice="@Model.MinPrice"
                               asp-route-MaxPrice="@Model.MaxPrice"
                               asp-route-SortBy="@Model.SortBy"
                               asp-route-PageIndex="@(Model.Books.PageIndex + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>


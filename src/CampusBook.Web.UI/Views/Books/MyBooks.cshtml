@model IEnumerable<BookItemViewModel>
@{
    ViewData["Title"] = "My Published Book Listings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">My Book Listings</h1>
        <p class="text-muted small mb-0">Manage the academic books you have offered for donation, sale, or exchange.</p>
    </div>
    <a asp-action="Create" class="btn btn-campus d-inline-flex align-items-center gap-2">
        <span>+</span> Publish New Book
    </a>
</div>

@if (!Model.Any())
{
    <div class="card card-campus shadow-sm p-5 text-center text-muted">
        <span class="fs-1 mb-2">📚</span>
        <h2 class="h5 fw-bold text-dark mb-1">No Books Listed Yet</h2>
        <p class="small mb-3">You haven't listed any academic textbooks yet. Share your completed course books with fellow students!</p>
        <div>
            <a asp-action="Create" class="btn btn-campus btn-sm">Publish Your First Book</a>
        </div>
    </div>
}
else
{
    <div class="card card-campus shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th style="width: 70px;">Cover</th>
                        <th>Book Title & Author</th>
                        <th>Subject Category</th>
                        <th>Type & Price</th>
                        <th>Condition</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(book.ImageUrl))
                                {
                                    <img src="@book.ImageUrl" alt="@book.Title" style="width: 50px; height: 65px; object-fit: cover; border-radius: 4px;" />
                                }
                                else
                                {
                                    <div class="bg-light text-muted d-flex align-items-center justify-content-center" style="width: 50px; height: 65px; border-radius: 4px;">
                                        📖
                                    </div>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@book.BookId" class="fw-bold text-dark text-decoration-none d-block">@book.Title</a>
                                <span class="small text-muted">by @book.Author &bull; Added @book.CreatedAt.ToDateText()</span>
                            </td>
                            <td class="small">
                                @book.CategoryName
                                @if (!string.IsNullOrEmpty(book.DepartmentName))
                                {
                                    <div class="text-muted small">@book.DepartmentName</div>
                                }
                            </td>
                            <td>
                                <span class="badge @(book.ExchangeType switch {
                                    ExchangeType.Donation => "badge-type-donation",
                                    ExchangeType.Sale => "badge-type-sale",
                                    _ => "badge-type-exchange"
                                })">@book.ExchangeType</span>
                                <div class="fw-bold text-primary small mt-1">@book.Price.ToPriceText()</div>
                            </td>
                            <td>
                                <span class="badge @(book.Condition switch {
                                    BookCondition.New => "badge-condition-new",
                                    BookCondition.Good => "badge-condition-good",
                                    BookCondition.Fair => "badge-condition-fair",
                                    _ => "badge-condition-poor"
                                })">@book.Condition</span>
                            </td>
                            <td>
                                <span class="badge @(book.Status switch {
                                    BookStatus.Available => "badge-status-available",
                                    BookStatus.Reserved => "badge-status-reserved",
                                    BookStatus.Completed => "badge-status-completed",
                                    _ => "badge-status-inactive"
                                })">@book.Status</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@book.BookId" class="btn btn-outline-secondary">View</a>
                                    @if (book.Status == BookStatus.Available)
                                    {
                                        <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-outline-primary">Edit</a>
                                        <form asp-action="Delete" asp-route-id="@book.BookId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate this listing?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger">Deactivate</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}


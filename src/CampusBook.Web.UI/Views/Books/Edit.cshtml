@model BookEditViewModel
@{
    ViewData["Title"] = "Edit Book Listing";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-9">
        <div class="card card-campus shadow-sm">
            <div class="card-header bg-white p-4 border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h4 fw-bold mb-1">Edit Book Listing</h1>
                    <p class="text-muted small mb-0">Update listing details or replace cover photograph</p>
                </div>
                <span class="badge @(Model.Status switch {
                    BookStatus.Available => "badge-status-available",
                    BookStatus.Reserved => "badge-status-reserved",
                    BookStatus.Completed => "badge-status-completed",
                    _ => "badge-status-inactive"
                })">@Model.Status</span>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="BookId" />
                    <input type="hidden" asp-for="ExistingImageUrl" />

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-4"></div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Author" class="form-label"></label>
                            <input asp-for="Author" class="form-control" />
                            <span asp-validation-for="Author" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Isbn" class="form-label"></label>
                            <input asp-for="Isbn" class="form-control" />
                            <span asp-validation-for="Isbn" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Edition" class="form-label"></label>
                            <input asp-for="Edition" class="form-control" />
                            <span asp-validation-for="Edition" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="CourseCode" class="form-label"></label>
                            <input asp-for="CourseCode" class="form-control" />
                            <span asp-validation-for="CourseCode" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label"></label>
                            <select asp-for="CategoryId" class="form-select" asp-items="Model.Categories"></select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DepartmentId" class="form-label"></label>
                            <select asp-for="DepartmentId" class="form-select" asp-items="Model.Departments">
                                <option value="">-- Optional: Relevant Department --</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Condition" class="form-label"></label>
                            <select asp-for="Condition" class="form-select">
                                <option value="New" selected="@(Model.Condition == BookCondition.New)">New</option>
                                <option value="Good" selected="@(Model.Condition == BookCondition.Good)">Good</option>
                                <option value="Fair" selected="@(Model.Condition == BookCondition.Fair)">Fair</option>
                                <option value="Poor" selected="@(Model.Condition == BookCondition.Poor)">Poor</option>
                            </select>
                            <span asp-validation-for="Condition" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExchangeType" class="form-label"></label>
                            <select asp-for="ExchangeType" id="exchangeTypeSelect" class="form-select">
                                <option value="Sale" selected="@(Model.ExchangeType == ExchangeType.Sale)">Sale</option>
                                <option value="Exchange" selected="@(Model.ExchangeType == ExchangeType.Exchange)">Book Exchange</option>
                            </select>
                            <span asp-validation-for="ExchangeType" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">৳</span>
                                <input asp-for="Price" id="priceInput" type="number" step="0.5" min="0" class="form-control" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Image" class="form-label"></label>
                        @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                        {
                            <div class="mb-2 d-flex align-items-center gap-3">
                                <img src="@Model.ExistingImageUrl" alt="Current Cover" style="width: 70px; height: 90px; object-fit: cover; border-radius: 4px;" />
                                <span class="small text-muted">Current cover image (upload new file to replace)</span>
                            </div>
                        }
                        <input asp-for="Image" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <span asp-validation-for="Image" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="MyBooks" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-campus px-4 py-2">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updatePriceInputState() {
            var type = $('#exchangeTypeSelect').val();
            var priceInput = $('#priceInput');
            if (type === 'Exchange') {
                priceInput.val('0');
                priceInput.prop('readonly', true);
            } else {
                priceInput.prop('readonly', false);
            }
        }

        $(document).ready(function() {
            updatePriceInputState();
            $('#exchangeTypeSelect').change(updatePriceInputState);
        });
    </script>
}


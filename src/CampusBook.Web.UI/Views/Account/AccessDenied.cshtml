@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="card card-campus shadow-sm p-4 p-md-5">
            <div class="mb-4">
                <span class="display-3 text-warning">🛑</span>
            </div>
            <h2 class="h4 fw-bold text-danger mb-3">Access Denied</h2>
            <p class="text-muted mb-4">
                You do not have permission to access the requested resource or perform this action.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-campus">Go to Dashboard</a>
                <a asp-controller="Books" asp-action="Index" class="btn btn-outline-secondary">Browse Books</a>
            </div>
        </div>
    </div>
</div>


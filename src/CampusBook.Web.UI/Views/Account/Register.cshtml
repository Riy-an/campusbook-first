@model RegisterViewModel
@{
    ViewData["Title"] = "Student Registration";
}

<div class="row justify-content-center py-4">
    <div class="col-md-9 col-lg-7">
        <div class="card card-campus shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <span class="fs-1 d-inline-block mb-1">🎓</span>
                    <h2 class="h4 fw-bold mb-1">Create Student Account</h2>
                    <p class="text-muted small">Join your campus book exchange network to buy, sell, and exchange textbooks</p>
                </div>

                <form asp-controller="Account" asp-action="Register" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="FullName" class="form-label fw-semibold small"></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Shahed Bin Hossan Riyan" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StudentId" class="form-label fw-semibold small"></label>
                            <input asp-for="StudentId" class="form-control" placeholder="e.g. 23103040" />
                            <span asp-validation-for="StudentId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold small">Contact No. <span class="text-muted fw-normal">(Optional)</span></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="01XXXXXXXXX (e.g. 01712-345678)" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <!-- Login/Personal Email -->
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small"></label>
                            <input asp-for="Email" class="form-control" placeholder="personal.email@gmail.com" />
                            <div class="form-text small text-muted">Used for login and account recovery (Gmail, Outlook, etc.).</div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- University Email -->
                        <div class="col-md-6">
                            <label asp-for="UniversityEmail" class="form-label fw-semibold small"></label>
                            <input asp-for="UniversityEmail" class="form-control" placeholder="student.id@university.edu.bd" />
                            <div class="form-text small text-muted">For institutional identification (no email code required).</div>
                            <span asp-validation-for="UniversityEmail" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label fw-semibold small"></label>
                            <input asp-for="Department" class="form-control" placeholder="e.g. Computer Science & Engineering" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Batch" class="form-label fw-semibold small"></label>
                            <input asp-for="Batch" class="form-control" placeholder="e.g. Fall 2026 / 54th Batch" />
                            <span asp-validation-for="Batch" class="text-danger small"></span>
                        </div>

                        <!-- Required University ID Card Upload -->
                        <div class="col-md-12">
                            <label asp-for="StudentIdCard" class="form-label fw-semibold small">
                                University ID Card Photo / Scan <span class="badge bg-danger-subtle text-danger border fw-normal">Required</span>
                            </label>
                            <input asp-for="StudentIdCard" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                            <div class="form-text small text-muted">Upload a clear photo or scan of your university student ID card (JPG, PNG, WebP &bull; Max 5MB). Stored securely and kept strictly private.</div>
                            <span asp-validation-for="StudentIdCard" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold small"></label>
                            <input asp-for="Password" class="form-control" placeholder="Minimum 6 characters" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="alert alert-light border small text-muted my-4 py-2 px-3 rounded-3 d-flex align-items-center gap-2">
                        <span class="fs-5">ℹ️</span>
                        <div><strong>Instant Activation:</strong> Your student account is activated upon registration. No email confirmation link needed!</div>
                    </div>

                    <button type="submit" class="btn btn-campus w-100 py-2 mb-3 shadow-sm">Register Student Account</button>

                    <div class="text-center small text-muted">
                        Already have an account? <a asp-action="Login" class="fw-semibold text-primary text-decoration-none">Sign in here</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

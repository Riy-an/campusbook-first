@model WantedBookFilterViewModel
@{
    ViewData["Title"] = "Wanted Books - Student Requests";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">Wanted Books 📢</h1>
        <p class="text-muted small mb-0">Browse books needed by fellow university students or post a request for a book you can't find.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="MyPosts" class="btn btn-outline-secondary btn-sm">My Wanted Posts</a>
        <a asp-action="Create" class="btn btn-campus btn-sm">+ Post a Wanted Book</a>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="card card-campus shadow-sm border-0 mb-4">
    <div class="card-body p-3 p-md-4">
        <form method="get" asp-action="Index">
            <div class="row g-2">
                <div class="col-md-5">
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search by book title, author, ISBN, or course code..." value="@Model.SearchTerm" />
                </div>
                <div class="col-md-3">
                    <select name="categoryId" class="form-select" asp-items="Model.Categories">
                        <option value="">All Categories</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="departmentId" class="form-select" asp-items="Model.Departments">
                        <option value="">All Departments</option>
                    </select>
                </div>
                <div class="col-md-1 d-grid">
                    <button type="submit" class="btn btn-campus">Search</button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!Model.Posts.Any())
{
    <div class="card card-campus text-center py-5 border-0 shadow-sm">
        <div class="card-body">
            <span class="fs-1 d-inline-block mb-2">🔍</span>
            <h2 class="h5 fw-bold mb-2">No Active Wanted-Book Posts Found</h2>
            <p class="text-muted small mb-3">There are currently no active requests matching your criteria.</p>
            <a asp-action="Create" class="btn btn-campus btn-sm px-4">Post the First Request</a>
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var post in Model.Posts)
        {
            <div class="col">
                <div class="card card-campus h-100 shadow-sm border p-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="badge bg-primary-subtle text-primary border me-1">@post.CategoryName</span>
                            @if (!string.IsNullOrEmpty(post.DepartmentName))
                            {
                                <span class="badge bg-light text-secondary border">@post.DepartmentName</span>
                            }
                        </div>
                        <span class="small text-muted">@post.CreatedAt.ToDateText()</span>
                    </div>

                    <h2 class="h5 fw-bold mb-1">
                        <a asp-action="Details" asp-route-id="@post.WantedBookId" class="text-dark text-decoration-none">
                            @post.Title
                        </a>
                    </h2>

                    @if (!string.IsNullOrEmpty(post.Author))
                    {
                        <div class="small text-muted mb-2">by @post.Author</div>
                    }

                    @if (!string.IsNullOrEmpty(post.Description))
                    {
                        <p class="small text-secondary mb-3 text-truncate-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @post.Description
                        </p>
                    }

                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center small">
                        <div>
                            @if (post.MaxBudget.HasValue)
                            {
                                <span class="text-muted">Max Budget: </span><strong class="text-primary">@post.MaxBudget.Value.ToPriceText()</strong>
                            }
                            else if (post.PreferredExchangeType == ExchangeType.Exchange)
                            {
                                <span class="badge badge-type-exchange">Exchange Preferred</span>
                            }
                            else
                            {
                                <span class="text-muted">Flexible Budget</span>
                            }
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <span class="text-muted">Requested by <strong>@post.PosterName</strong></span>
                            <a asp-action="Details" asp-route-id="@post.WantedBookId" class="btn btn-sm btn-campus-outline">
                                View Details &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@model IEnumerable<WantedBookItemViewModel>
@{
    ViewData["Title"] = "My Wanted Book Posts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1">My Wanted Posts 📢</h1>
        <p class="text-muted small mb-0">Manage the book requests you have posted for the student community.</p>
    </div>
    <a asp-action="Create" class="btn btn-campus btn-sm">+ Post New Request</a>
</div>

@if (!Model.Any())
{
    <div class="card card-campus text-center py-5 border-0 shadow-sm">
        <div class="card-body">
            <span class="fs-1 d-inline-block mb-2">📢</span>
            <h2 class="h5 fw-bold mb-2">You Have Not Posted Any Book Requests</h2>
            <p class="text-muted small mb-3">Looking for a specific textbook for your courses? Post a request to let students know!</p>
            <a asp-action="Create" class="btn btn-campus px-4 py-2">Create Wanted-Book Post</a>
        </div>
    </div>
}
else
{
    <div class="card card-campus shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th class="ps-4">Book Request</th>
                        <th>Category</th>
                        <th>Budget / Type</th>
                        <th>Status</th>
                        <th>Posted</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var post in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold">
                                    <a asp-action="Details" asp-route-id="@post.WantedBookId" class="text-dark text-decoration-none">
                                        @post.Title
                                    </a>
                                </div>
                                <div class="small text-muted">@(string.IsNullOrEmpty(post.Author) ? "Any author" : $"by {post.Author}")</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@post.CategoryName</span>
                            </td>
                            <td>
                                @if (post.MaxBudget.HasValue)
                                {
                                    <span class="text-primary fw-semibold">@post.MaxBudget.Value.ToPriceText()</span>
                                }
                                else if (post.PreferredExchangeType == ExchangeType.Exchange)
                                {
                                    <span class="badge badge-type-exchange">Exchange</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Any Type</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(post.Status switch {
                                    WantedBookStatus.Active => "bg-success",
                                    WantedBookStatus.Fulfilled => "bg-info text-dark",
                                    _ => "bg-secondary"
                                })">@post.Status</span>
                            </td>
                            <td class="small text-muted">@post.CreatedAt.ToDateText()</td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@post.WantedBookId" class="btn btn-outline-secondary" title="View Details and Matches">
                                        Matches
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@post.WantedBookId" class="btn btn-outline-primary" title="Edit Post">
                                        Edit
                                    </a>
                                    @if (post.Status == WantedBookStatus.Active)
                                    {
                                        <form asp-action="Close" asp-route-id="@post.WantedBookId" method="post" class="d-inline" onsubmit="return confirm('Close this book request?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger">Close</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

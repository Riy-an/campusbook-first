@model CampusBook.Facade.ViewModels.Admin.CourseEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.CourseId > 0 ? "Edit Course" : "Add Course";
    var departments = ViewBag.Departments as IEnumerable<CampusBook.Entities.Department> ?? Enumerable.Empty<CampusBook.Entities.Department>();
}

<div class="mb-3">
    <a asp-action="Courses" class="btn btn-sm btn-link text-decoration-none px-0">&larr; Back to Courses</a>
    <h2 class="h4 fw-bold">@(Model.CourseId > 0 ? "Edit Course" : "Add Course Classification")</h2>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <form asp-action="SaveCourse" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CourseId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="DepartmentId" class="form-label small fw-bold">Department</label>
                        <select asp-for="DepartmentId" class="form-select" required>
                            <option value="">-- Select Academic Department --</option>
                            @foreach (var d in departments)
                            {
                                <option value="@d.DepartmentId">@d.Name (@d.Code)</option>
                            }
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CourseCode" class="form-label small fw-bold">Course Code</label>
                        <input asp-for="CourseCode" class="form-control" placeholder="e.g. CSE-3101" required />
                        <span asp-validation-for="CourseCode" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CourseName" class="form-label small fw-bold">Course Full Title</label>
                        <input asp-for="CourseName" class="form-control" placeholder="e.g. Database Management Systems" required />
                        <span asp-validation-for="CourseName" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isCourseActiveCheck" />
                        <label class="form-check-label small" for="isCourseActiveCheck">
                            Course is active
                        </label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm px-4">Save Course</button>
                        <a asp-action="Courses" class="btn btn-outline-secondary btn-sm">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

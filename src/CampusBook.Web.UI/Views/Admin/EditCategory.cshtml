@model CampusBook.Facade.ViewModels.Admin.CategoryEditViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = Model.CategoryId > 0 ? "Edit Category" : "Add Category";
}

<div class="mb-3">
    <a asp-action="Categories" class="btn btn-sm btn-link text-decoration-none px-0">&larr; Back to Categories</a>
    <h2 class="h4 fw-bold">@(Model.CategoryId > 0 ? "Edit Category" : "Add New Category")</h2>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <form asp-action="SaveCategory" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CategoryId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label small fw-bold">Category Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Computer Science & IT" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label small fw-bold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief explanation of subject area..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveCheck" />
                        <label class="form-check-label small" for="isActiveCheck">
                            Category is active and visible in catalogue filters
                        </label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm px-4">Save Category</button>
                        <a asp-action="Categories" class="btn btn-outline-secondary btn-sm">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@model CampusBook.Facade.ViewModels.Admin.CategoryManagementViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Category Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h4 fw-bold mb-1">Book Category Management</h2>
        <p class="text-muted small mb-0">Manage textbook categories and subjects across the university marketplace.</p>
    </div>
    <div>
        <a asp-action="CreateCategory" class="btn btn-primary btn-sm">+ Add New Category</a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Category Name</th>
                    <th>Description</th>
                    <th>Associated Books</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (cat, count) in Model.Categories)
                {
                    <tr>
                        <td class="fw-bold">@cat.Name</td>
                        <td class="small text-muted">@cat.Description</td>
                        <td><span class="badge bg-light text-dark border">@count listings</span></td>
                        <td>
                            @if (cat.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="EditCategory" asp-route-id="@cat.CategoryId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form asp-action="ToggleCategory" asp-route-id="@cat.CategoryId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(cat.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                        @(cat.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

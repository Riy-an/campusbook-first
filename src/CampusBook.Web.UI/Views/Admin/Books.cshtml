@model CampusBook.Facade.ViewModels.Admin.BookModerationListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Book Moderation";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h4 fw-bold mb-1">Book Listing Moderation</h2>
        <p class="text-muted small mb-0">Review student book listings, monitor sale/exchange items, and approve or archive content.</p>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Search by title, author, ISBN, or owner..." />
            </div>
            <div class="col-md-3">
                <select name="categoryId" class="form-select form-select-sm">
                    <option value="">All Categories</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.CategoryId" selected="@(Model.CategoryId == c.CategoryId)">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="1" selected="@(Model.Status == CampusBook.Entities.BookStatus.Available)">Available Only</option>
                    <option value="2" selected="@(Model.Status == CampusBook.Entities.BookStatus.Reserved)">Reserved Only</option>
                    <option value="3" selected="@(Model.Status == CampusBook.Entities.BookStatus.Completed)">Completed Only</option>
                    <option value="4" selected="@(Model.Status == CampusBook.Entities.BookStatus.Inactive)">Archived / Inactive Only</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Books Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Book Details</th>
                    <th>Category</th>
                    <th>Type / Price</th>
                    <th>Owner</th>
                    <th>Status</th>
                    <th>Listed On</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Books.Any())
                {
                    @foreach (var b in Model.Books)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@b.Title</div>
                                <div class="text-muted small">By @b.Author &bull; @b.Condition</div>
                            </td>
                            <td><span class="badge bg-light text-dark border">@b.Category?.Name</span></td>
                            <td>
                                @if (b.ExchangeType == CampusBook.Entities.ExchangeType.Sale)
                                {
                                    <span class="badge bg-primary">Sale: ৳@b.Price</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">Exchange</span>
                                }
                            </td>
                            <td>
                                <div>@b.Owner?.FullName</div>
                                <div class="text-muted small" style="font-size: 11px;">@b.Owner?.StudentId</div>
                            </td>
                            <td>
                                <span class="badge @(b.Status == CampusBook.Entities.BookStatus.Available ? "bg-success" : (b.Status == CampusBook.Entities.BookStatus.Reserved ? "bg-warning text-dark" : "bg-secondary"))">
                                    @b.Status
                                </span>
                            </td>
                            <td class="small text-muted">@b.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <a asp-action="BookDetails" asp-route-id="@b.BookId" class="btn btn-sm btn-outline-primary">
                                    Inspect &rarr;
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            No book listings match the filter criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="Books" asp-route-page="@p" asp-route-search="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-status="@Model.Status">@p</a>
                </li>
            }
        </ul>
    </nav>
}

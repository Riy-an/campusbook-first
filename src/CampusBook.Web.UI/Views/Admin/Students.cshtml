@model CampusBook.Facade.ViewModels.Admin.StudentListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Student Accounts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h4 fw-bold mb-1">Student Account Management</h2>
        <p class="text-muted small mb-0">Manage verified campus profiles, inspect university IDs, and handle account statuses.</p>
    </div>
    <div>
        <a asp-action="ExportStudentsCsv" class="btn btn-outline-success btn-sm">Export to CSV 📥</a>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Search by name, student ID, or email..." />
            </div>
            <div class="col-md-2">
                <select name="isActive" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    <option value="true" selected="@(Model.IsActive == true)">Active Only</option>
                    <option value="false" selected="@(Model.IsActive == false)">Suspended Only</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="verificationStatus" class="form-select form-select-sm">
                    <option value="">All Verification</option>
                    <option value="1" selected="@(Model.VerificationStatus == CampusBook.Entities.StudentVerificationStatus.Pending)">Pending Verification</option>
                    <option value="2" selected="@(Model.VerificationStatus == CampusBook.Entities.StudentVerificationStatus.Verified)">Verified</option>
                    <option value="3" selected="@(Model.VerificationStatus == CampusBook.Entities.StudentVerificationStatus.Rejected)">Rejected</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="sortBy" class="form-select form-select-sm">
                    <option value="">Newest First</option>
                    <option value="date_asc" selected="@(Model.SortBy == "date_asc")">Oldest First</option>
                    <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Name (A-Z)</option>
                    <option value="name_desc" selected="@(Model.SortBy == "name_desc")">Name (Z-A)</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Students Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Student Name</th>
                    <th>Student ID</th>
                    <th>Department / Batch</th>
                    <th>Verification</th>
                    <th>Account Status</th>
                    <th>Joined</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Students.Any())
                {
                    @foreach (var s in Model.Students)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@s.FullName</div>
                                <div class="text-muted small">@s.Email</div>
                            </td>
                            <td><span class="badge bg-light text-dark border">@s.StudentId</span></td>
                            <td class="small">
                                @(s.StudentProfile?.Department ?? "N/A")
                                <div class="text-muted" style="font-size: 11px;">@(s.StudentProfile?.Batch ?? "")</div>
                            </td>
                            <td>
                                @if (s.StudentProfile?.VerificationStatus == CampusBook.Entities.StudentVerificationStatus.Verified)
                                {
                                    <span class="badge bg-success">Verified</span>
                                }
                                else if (s.StudentProfile?.VerificationStatus == CampusBook.Entities.StudentVerificationStatus.Rejected)
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger">Suspended</span>
                                }
                            </td>
                            <td class="small text-muted">@s.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end">
                                <a asp-action="StudentDetails" asp-route-id="@s.UserId" class="btn btn-sm btn-outline-primary">
                                    Inspect & Review &rarr;
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            No student accounts match the filter criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="Students" asp-route-page="@p" asp-route-search="@Model.SearchTerm" asp-route-isActive="@Model.IsActive" asp-route-verificationStatus="@Model.VerificationStatus" asp-route-sortBy="@Model.SortBy">@p</a>
                </li>
            }
        </ul>
    </nav>
}

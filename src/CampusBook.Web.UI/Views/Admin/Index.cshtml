@model CampusBook.Facade.ViewModels.Admin.AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
        <h2 class="h4 fw-bold mb-1">Administrative Overview</h2>
        <p class="text-muted small mb-0">System metrics, real-time activity, and campus operations.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Analytics" class="btn btn-neu btn-sm">Full Analytics 📈</a>
        <a asp-action="AuditLogs" class="btn btn-neu btn-sm">Security Audit 📜</a>
    </div>
</div>

<!-- Primary Metric Cards -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
    <div class="col">
        <div class="stat-card h-100">
            <div>
                <div class="text-uppercase small fw-bold text-muted">Students</div>
                <div class="stat-number text-primary">@Model.TotalStudents</div>
                <div class="small mt-1 text-muted">@Model.ActiveStudents Active &bull; <span class="badge bg-warning text-dark">@Model.PendingVerificationStudents Pending</span></div>
            </div>
            <div class="stat-icon-wrapper text-primary">👨‍🎓</div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card h-100">
            <div>
                <div class="text-uppercase small fw-bold text-muted">Book Listings</div>
                <div class="stat-number text-success">@Model.TotalBooks</div>
                <div class="small mt-1 text-muted">@Model.AvailableBooks Available &bull; @Model.ReservedBooks Reserved</div>
            </div>
            <div class="stat-icon-wrapper text-success">📚</div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card h-100">
            <div>
                <div class="text-uppercase small fw-bold text-muted">Completed Trades</div>
                <div class="stat-number text-info">@(Model.CompletedSales + Model.CompletedExchanges)</div>
                <div class="small mt-1 text-muted">@Model.CompletedSales Sales &bull; @Model.CompletedExchanges Exchanges</div>
            </div>
            <div class="stat-icon-wrapper text-info">🤝</div>
        </div>
    </div>
    <div class="col">
        <div class="stat-card h-100">
            <div>
                <div class="text-uppercase small fw-bold text-muted">Complaints & Flags</div>
                <div class="stat-number text-danger">@Model.TotalReports</div>
                <div class="small mt-1 text-muted"><span class="badge bg-danger-subtle text-danger">@Model.PendingReports Pending</span></div>
            </div>
            <div class="stat-icon-wrapper text-danger">⚠️</div>
        </div>
    </div>
</div>

<!-- Secondary Metrics Breakdown -->
<div class="row row-cols-1 row-cols-lg-3 g-3 mb-4">
    <div class="col">
        <div class="neu-card p-3 h-100">
            <h6 class="fw-bold mb-3 text-secondary">Student Account Statuses</h6>
            <ul class="list-group list-group-flush small bg-transparent">
                <li class="list-group-item bg-transparent d-flex justify-content-between px-0">
                    <span>Verified Accounts</span>
                    <span class="badge bg-success">@Model.VerifiedStudents</span>
                </li>
                <li class="list-group-item bg-transparent d-flex justify-content-between px-0">
                    <span>Pending Verification</span>
                    <span class="badge bg-warning text-dark">@Model.PendingVerificationStudents</span>
                </li>
                <li class="list-group-item bg-transparent d-flex justify-content-between px-0">
                    <span>Rejected Verification</span>
                    <span class="badge bg-secondary">@Model.RejectedVerificationStudents</span>
                </li>
                <li class="list-group-item bg-transparent d-flex justify-content-between px-0">
                    <span>Suspended Accounts</span>
                    <span class="badge bg-danger">@Model.SuspendedStudents</span>
                </li>
            </ul>
        </div>
    </div>
    <div class="col">
        <div class="neu-card p-3 h-100">
            <h6 class="fw-bold mb-3 text-secondary">Request & Handover Funnel</h6>
            <ul class="list-group list-group-flush small bg-transparent">
                <li class="list-group-item bg-transparent d-flex justify-content-between px-0">
                    <span>Pending Requests</span>
                    <span class="badge bg-warning text-dark">@Model.PendingRequests</span>
                </li>
                <li class="list-group-item bg-transparent d-flex justify-content-between px-0">
                    <span>Accepted & Reserved</span>
                    <span class="badge bg-info text-dark">@Model.AcceptedRequests</span>
                </li>
                <li class="list-group-item bg-transparent d-flex justify-content-between px-0">
                    <span>Completed Handovers</span>
                    <span class="badge bg-success">@Model.CompletedRequests</span>
                </li>
                <li class="list-group-item bg-transparent d-flex justify-content-between px-0">
                    <span>Rejected / Cancelled</span>
                    <span class="badge bg-secondary">@(Model.RejectedRequests + Model.CancelledRequests)</span>
                </li>
            </ul>
        </div>
    </div>
    <div class="col">
        <div class="neu-card p-3 h-100">
            <h6 class="fw-bold mb-3 text-secondary">Category Distribution</h6>
        <div class="neu-card p-3 h-100">
            <h6 class="fw-bold mb-3 text-secondary">Category Distribution</h6>
            @if (Model.CategoryDistribution.Any())
            {
                <ul class="list-group list-group-flush small">
                    @foreach (var cat in Model.CategoryDistribution.Take(4))
                    {
                        <li class="list-group-item d-flex justify-content-between px-0">
                            <span class="text-truncate" style="max-width: 180px;">@cat.Key</span>
                            <span class="badge bg-light text-dark border">@cat.Value books</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted small my-auto text-center">No categories populated yet.</p>
            }
        </div>
    </div>
</div>

<!-- Recent Activity Tables -->
<div class="row row-cols-1 row-cols-xl-2 g-4">
    <div class="col">
        <div class="neu-card border-0 h-100">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">Recent Registrations</h6>
                <a asp-action="Students" class="btn btn-sm btn-link p-0 text-decoration-none">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Student</th>
                            <th>ID</th>
                            <th>Status</th>
                            <th>Joined</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var s in Model.RecentStudents)
                        {
                            <tr>
                                <td>
                                    <a asp-action="StudentDetails" asp-route-id="@s.UserId" class="fw-bold text-decoration-none text-dark">
                                        @s.FullName
                                    </a>
                                    <div class="text-muted" style="font-size: 11px;">@s.Email</div>
                                </td>
                                <td>@s.StudentId</td>
                                <td>
                                    @if (s.StudentProfile?.VerificationStatus == CampusBook.Entities.StudentVerificationStatus.Verified)
                                    {
                                        <span class="badge bg-success">Verified</span>
                                    }
                                    else if (s.StudentProfile?.VerificationStatus == CampusBook.Entities.StudentVerificationStatus.Rejected)
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>
                                <td class="text-muted">@s.CreatedAt.ToString("MMM dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="neu-card border-0 h-100">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">Recent Book Listings</h6>
                <a asp-action="Books" class="btn btn-sm btn-link p-0 text-decoration-none">View All</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Title</th>
                            <th>Owner</th>
                            <th>Type</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var b in Model.RecentBooks)
                        {
                            <tr>
                                <td>
                                    <a asp-action="BookDetails" asp-route-id="@b.BookId" class="fw-bold text-decoration-none text-dark">
                                        @b.Title
                                    </a>
                                    <div class="text-muted" style="font-size: 11px;">@b.Author</div>
                                </td>
                                <td>@b.Owner?.FullName</td>
                                <td><span class="badge bg-light text-dark border">@b.ExchangeType</span></td>
                                <td>
                                    <span class="badge @(b.Status == CampusBook.Entities.BookStatus.Available ? "bg-success" : (b.Status == CampusBook.Entities.BookStatus.Reserved ? "bg-warning text-dark" : "bg-secondary"))">
                                        @b.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

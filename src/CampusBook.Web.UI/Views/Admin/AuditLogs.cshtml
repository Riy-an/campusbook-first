@model CampusBook.Facade.ViewModels.Admin.AuditLogListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Security & Audit Logs";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="h4 fw-bold mb-1">Immutable Administrative Audit Log</h2>
        <p class="text-muted small mb-0">Chronological ledger of security decisions, student verification, moderation, and intervention.</p>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <input type="text" name="action" value="@Model.Action" class="form-control form-control-sm" placeholder="Filter by action name (e.g. Student.Suspended, Book.Approved)..." />
            </div>
            <div class="col-md-4">
                <input type="number" name="adminUserId" value="@Model.AdminUserId" class="form-control form-control-sm" placeholder="Filter by Admin User ID..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0 font-monospace" style="font-size: 12px;">
            <thead class="table-dark">
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>Admin</th>
                    <th>Action</th>
                    <th>Target</th>
                    <th>Details</th>
                    <th>IP Address</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Logs.Any())
                {
                    @foreach (var log in Model.Logs)
                    {
                        <tr>
                            <td class="text-nowrap">@log.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                @if (log.AdminUser != null)
                                {
                                    <span class="fw-bold">@log.AdminUser.FullName</span>
                                }
                                else
                                {
                                    <span class="text-muted">System (ID: @(log.AdminUserId?.ToString() ?? "N/A"))</span>
                                }
                            </td>
                            <td><span class="badge bg-primary">@log.Action</span></td>
                            <td><span class="badge bg-light text-dark border">@log.TargetEntityType #@log.TargetId</span></td>
                            <td class="text-break font-sans-serif" style="font-family: sans-serif;">@log.Details</td>
                            <td class="text-muted text-nowrap">@(log.IpAddress ?? "Unknown")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            No audit log records found matching the filter criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="AuditLogs" asp-route-page="@p" asp-route-action="@Model.Action" asp-route-adminUserId="@Model.AdminUserId">@p</a>
                </li>
            }
        </ul>
    </nav>
}

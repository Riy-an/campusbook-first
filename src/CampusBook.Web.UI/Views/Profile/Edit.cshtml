@model ProfileEditViewModel
@{
    ViewData["Title"] = "Edit Student Profile";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <div class="card card-campus shadow-sm">
            <div class="card-header bg-white p-4 border-bottom">
                <h1 class="h4 fw-bold mb-1">Edit Student Profile</h1>
                <p class="text-muted small mb-0">Update your academic details, contact information, and biography</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Protected Non-Editable Fields -->
                    <div class="row mb-4 g-3">
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Student ID (Non-modifiable)</label>
                            <input class="form-control bg-light" value="@Model.StudentId" readonly />
                            <small class="text-muted">Assigned ID</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Personal / Login Email</label>
                            <input class="form-control bg-light" value="@Model.Email" readonly />
                            <small class="text-muted">Account login address</small>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">University Email</label>
                            <input class="form-control bg-light" value="@Model.UniversityEmail" readonly />
                            <small class="text-muted">Institutional address</small>
                        </div>
                    </div>

                    <hr class="mb-4" />

                    <!-- Editable Fields -->
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Department" class="form-label"></label>
                            <input asp-for="Department" class="form-control" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Batch" class="form-label"></label>
                            <input asp-for="Batch" class="form-control" />
                            <span asp-validation-for="Batch" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Semester" class="form-label"></label>
                            <input asp-for="Semester" class="form-control" placeholder="e.g. 5th Semester / Junior" />
                            <span asp-validation-for="Semester" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="form-label">Contact No. <span class="text-muted fw-normal small">(Optional)</span></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="01XXXXXXXXX (e.g. 01712-345678)" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12 mb-3">
                            <label asp-for="Bio" class="form-label"></label>
                            <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Share your academic interests, courses, or study focus..."></textarea>
                            <span asp-validation-for="Bio" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12 mb-4">
                            <label asp-for="ProfilePicture" class="form-label"></label>
                            @if (!string.IsNullOrEmpty(Model.CurrentProfilePictureUrl))
                            {
                                <div class="mb-2 d-flex align-items-center gap-3">
                                    <img src="@Model.CurrentProfilePictureUrl" alt="Current Photo" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;" />
                                    <span class="small text-muted">Current photo (upload new file to replace)</span>
                                </div>
                            }
                            <input asp-for="ProfilePicture" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                            <span asp-validation-for="ProfilePicture" class="text-danger small"></span>
                            <small class="text-muted">Allowed formats: JPG, PNG, WEBP. Maximum file size: 2MB.</small>
                        </div>

                        <!-- University ID Card Upload Section -->
                        <div class="col-md-12 mb-4">
                            <div class="p-3 border rounded-3 bg-light">
                                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                    <label asp-for="StudentIdCard" class="form-label fw-bold mb-0">University ID Card Photo</label>
                                    <span class="badge @(Model.CanChangeIdCard ? "bg-info text-dark" : "bg-danger")">
                                        @Model.IdCardChangeCount / 3 Changes Used (@Model.RemainingIdCardChanges Remaining)
                                    </span>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.CurrentStudentIdCardUrl))
                                {
                                    <div class="mb-3 d-flex align-items-center gap-3">
                                        <a href="@Model.CurrentStudentIdCardUrl" target="_blank" class="d-inline-block border rounded overflow-hidden shadow-sm" style="max-width: 120px; max-height: 80px;">
                                            <img src="@Model.CurrentStudentIdCardUrl" alt="Current ID Card" style="width: 100%; height: 100%; object-fit: cover;" />
                                        </a>
                                        <div>
                                            <div class="small fw-semibold text-secondary">Current ID Card Document</div>
                                            <a href="@Model.CurrentStudentIdCardUrl" target="_blank" class="btn btn-sm btn-outline-secondary mt-1">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>View Current Document
                                            </a>
                                        </div>
                                    </div>
                                }

                                @if (Model.CanChangeIdCard)
                                {
                                    <input asp-for="StudentIdCard" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                                    <span asp-validation-for="StudentIdCard" class="text-danger small d-block mt-1"></span>
                                    <div class="form-text small text-muted mt-1">
                                        <i class="bi bi-info-circle me-1"></i>One user can only change their ID card photo <strong>3 times</strong>.
                                        You currently have <strong>@Model.RemainingIdCardChanges</strong> change@(Model.RemainingIdCardChanges == 1 ? "" : "s") remaining. Allowed formats: JPG, PNG, WEBP (Max 5MB).
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning mb-0 py-2 small">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                        You have reached the maximum limit of <strong>3 ID card photo changes</strong>. You cannot update your ID card photo any further.
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-campus px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


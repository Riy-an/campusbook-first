@model PublicProfileViewModel
@{
    ViewData["Title"] = $"{Model.FullName} - Student Profile";
}

<div class="row g-4 py-4">
    <div class="col-lg-4">
        <div class="card card-campus shadow-sm text-center p-4">
            <div class="mb-3 d-flex justify-content-center">
                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                {
                    <img src="@Model.ProfilePictureUrl" alt="@Model.FullName" class="profile-avatar-lg" />
                }
                else
                {
                    <div class="profile-avatar-placeholder-lg">
                        @Model.FullName.FirstOrDefault()
                    </div>
                }
            </div>

            <h1 class="h4 fw-bold mb-1">@Model.FullName</h1>
            <p class="text-muted small mb-3">@Model.Department &bull; @Model.Batch</p>

            @if (!string.IsNullOrEmpty(Model.Bio))
            {
                <p class="small text-muted border-top border-bottom py-3 my-3 text-start">
                    @Model.Bio
                </p>
            }

            <ul class="list-group list-group-flush text-start small mt-2">
                <li class="list-group-item d-flex justify-content-between px-0">
                    <span class="text-muted">Semester:</span>
                    <span class="fw-semibold">@(Model.Semester ?? "Not specified")</span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-0">
                    <span class="text-muted">Completed Exchanges:</span>
                    <span class="fw-semibold text-success">@Model.CompletedExchangesCount</span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-0">
                    <span class="text-muted">Member Since:</span>
                    <span class="fw-semibold">@Model.MemberSince.ToDateText()</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 fw-bold mb-0">Available Books by @Model.FullName (@Model.AvailableListings.Count())</h2>
        </div>

        @if (!Model.AvailableListings.Any())
        {
            <div class="card card-campus shadow-sm p-5 text-center text-muted">
                <span class="fs-1 mb-2">📚</span>
                <p class="mb-0">This student currently has no available books listed.</p>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 g-3">
                @foreach (var book in Model.AvailableListings)
                {
                    <div class="col">
                        <div class="card card-campus h-100 shadow-sm">
                            <div class="book-cover-container" style="height: 180px;">
                                @if (!string.IsNullOrEmpty(book.ImageUrl))
                                {
                                    <img src="@book.ImageUrl" alt="@book.Title" class="book-cover-img" />
                                }
                                else
                                {
                                    <div class="book-cover-placeholder">
                                        <span class="fs-2">📖</span>
                                        <span class="small">No Cover Image</span>
                                    </div>
                                }
                            </div>
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge @(book.ExchangeType switch {
                                        ExchangeType.Donation => "badge-type-donation",
                                        ExchangeType.Sale => "badge-type-sale",
                                        _ => "badge-type-exchange"
                                    })">@book.ExchangeType</span>

                                    <span class="badge @(book.Condition switch {
                                        BookCondition.New => "badge-condition-new",
                                        BookCondition.Good => "badge-condition-good",
                                        BookCondition.Fair => "badge-condition-fair",
                                        _ => "badge-condition-poor"
                                    })">@book.Condition</span>
                                </div>

                                <h3 class="h6 fw-bold mb-1 text-truncate">@book.Title</h3>
                                <p class="small text-muted mb-2 text-truncate">by @book.Author</p>
                                <div class="fw-bold text-primary mb-3">@book.Price.ToPriceText()</div>

                                <a asp-controller="Books" asp-action="Details" asp-route-id="@book.BookId" class="btn btn-sm btn-campus w-100">View Book Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>


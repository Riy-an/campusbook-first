@model CampusBook.Facade.ViewModels.Admin.CreateReportViewModel
@{
    ViewData["Title"] = "Report Suspicious or Abusive Content";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="card-title h6 fw-bold mb-0">⚠️ Report to CampusBook Moderators</h5>
                </div>
                <div class="card-body p-4">
                    <p class="small text-muted mb-3">
                        If you encounter suspicious listings, abusive communication, or policy violations, please report it. Our campus administrative team investigates every report.
                    </p>

                    <div class="alert alert-light border small mb-3">
                        Reporting Target: <strong>@Model.TargetType</strong> &bull; <strong>@Model.TargetTitle</strong>
                    </div>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="TargetType" />
                        <input type="hidden" asp-for="TargetId" />
                        <input type="hidden" asp-for="TargetTitle" />
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                        <div class="mb-3">
                            <label asp-for="Reason" class="form-label small fw-bold">Reason for Report</label>
                            <select asp-for="Reason" class="form-select" required>
                                <option value="">-- Select a reason --</option>
                                <option value="Inappropriate Content">Inappropriate / Offensive Content</option>
                                <option value="Fraudulent or Fake Listing">Fraudulent or Fake Listing</option>
                                <option value="Abusive or Harassing Message">Abusive or Harassing Communication</option>
                                <option value="Wrong University Affiliation">Fake or Impersonated Student Account</option>
                                <option value="Other Policy Violation">Other Policy Violation</option>
                            </select>
                            <span asp-validation-for="Reason" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label small fw-bold">Description / Explanation</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Please provide specific details to assist our moderation team..." required></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger btn-sm px-4">Submit Report</button>
                            @if (!string.IsNullOrEmpty(Model.ReturnUrl))
                            {
                                <a href="@Model.ReturnUrl" class="btn btn-outline-secondary btn-sm">Cancel</a>
                            }
                            else
                            {
                                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancel</a>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

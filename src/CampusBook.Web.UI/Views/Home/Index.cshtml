@{
    ViewData["Title"] = "CampusBook - University Book Exchange System";
}

<!-- Hero Section -->
<div class="hero-banner text-center py-5">
    <div class="container py-lg-4">
        <span class="badge bg-warning text-dark fw-bold px-3 py-2 mb-3">🎓 Exclusively for Verified University Students</span>
        <h1 class="display-4 fw-bold mb-3">Don't Let Good Books Gather Dust.</h1>
        <p class="lead mb-4 mx-auto" style="max-width: 700px;">
            CampusBook connects university peers to share, donate, and exchange academic textbooks safely and affordably right on campus.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Books" asp-action="Index" class="btn btn-warning btn-lg fw-bold text-dark px-4 py-2">
                Browse Available Books
            </a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg px-4 py-2">
                Register Student Account
            </a>
        </div>
    </div>
</div>

<!-- Three Core Exchange Pillars -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card card-campus h-100 shadow-sm text-center p-4">
            <div class="display-4 text-success mb-3">🎁</div>
            <h2 class="h5 fw-bold mb-2">Book Donations</h2>
            <p class="text-muted small mb-0">
                Senior students pass down completed course textbooks to incoming juniors completely free of charge.
            </p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-campus h-100 shadow-sm text-center p-4">
            <div class="display-4 text-primary mb-3">🏷️</div>
            <h2 class="h5 fw-bold mb-2">Affordable Resale</h2>
            <p class="text-muted small mb-0">
                Buy and sell academic textbooks at fair, student-friendly rates, bypassing expensive commercial bookstores.
            </p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-campus h-100 shadow-sm text-center p-4">
            <div class="display-4 text-purple mb-3">🔄</div>
            <h2 class="h5 fw-bold mb-2">Book-for-Book Trade</h2>
            <p class="text-muted small mb-0">
                Swap a book from your finished courses for a required textbook in your current semester's curriculum.
            </p>
        </div>
    </div>
</div>

<!-- How It Works Section -->
<div class="card card-campus shadow-sm p-4 p-md-5 mb-5 bg-white">
    <h2 class="h4 fw-bold text-center mb-4">How CampusBook Works</h2>
    <div class="row g-4 text-center">
        <div class="col-md-3">
            <div class="badge rounded-circle bg-primary fs-5 p-3 mb-3">1</div>
            <h3 class="h6 fw-bold">Register & Verify</h3>
            <p class="small text-muted">Sign up with your university email address and Student ID to get verified.</p>
        </div>
        <div class="col-md-3">
            <div class="badge rounded-circle bg-primary fs-5 p-3 mb-3">2</div>
            <h3 class="h6 fw-bold">Browse or List</h3>
            <p class="small text-muted">Search course books by title, author, or ISBN, or publish your own used books.</p>
        </div>
        <div class="col-md-3">
            <div class="badge rounded-circle bg-primary fs-5 p-3 mb-3">3</div>
            <h3 class="h6 fw-bold">Send Exchange Request</h3>
            <p class="small text-muted">Request the book online. The book is reserved once the owner accepts your request.</p>
        </div>
        <div class="col-md-3">
            <div class="badge rounded-circle bg-primary fs-5 p-3 mb-3">4</div>
            <h3 class="h6 fw-bold">Meet on Campus</h3>
            <p class="small text-muted">Hand over the book on campus and both confirm the exchange to finalize.</p>
        </div>
    </div>
</div>

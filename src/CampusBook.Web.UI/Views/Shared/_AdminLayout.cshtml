@{
    Layout = "_Layout";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<div class="container-fluid p-0">
    <!-- Admin Sub-Navigation Header Bar -->
    <div class="neu-card p-3 mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pb-3 border-bottom mb-3">
            <div class="d-flex align-items-center gap-2">
                <span class="fs-4">🛡️</span>
                <div>
                    <h2 class="h5 fw-bold mb-0">System Administration Center</h2>
                    <span class="text-muted small">Governance, content moderation & security oversight</span>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Admin" asp-action="Analytics" class="btn btn-neu btn-sm">
                    📈 Analytics
                </a>
                <a asp-controller="Admin" asp-action="AuditLogs" class="btn btn-neu btn-sm">
                    📜 Audit Trail
                </a>
            </div>
        </div>

        <!-- Scrollable Horizontal Soft UI Tabs -->
        <div class="d-flex gap-2 overflow-auto pb-1" style="scrollbar-width: thin;">
            <a asp-controller="Admin" asp-action="Index" 
               class="btn btn-sm @(currentAction == "Index" ? "btn-primary" : "btn-neu")" style="white-space: nowrap;">
                📊 Dashboard
            </a>
            <a asp-controller="Admin" asp-action="Students" 
               class="btn btn-sm @(currentAction.StartsWith("Student") ? "btn-primary" : "btn-neu")" style="white-space: nowrap;">
                👨‍🎓 Students
            </a>
            <a asp-controller="Admin" asp-action="Books" 
               class="btn btn-sm @(currentAction.StartsWith("Book") ? "btn-primary" : "btn-neu")" style="white-space: nowrap;">
                📚 Book Listings
            </a>
            <a asp-controller="Admin" asp-action="Categories" 
               class="btn btn-sm @(currentAction.Contains("Categor") ? "btn-primary" : "btn-neu")" style="white-space: nowrap;">
                🏷️ Categories
            </a>
            <a asp-controller="Admin" asp-action="Departments" 
               class="btn btn-sm @(currentAction.Contains("Department") ? "btn-primary" : "btn-neu")" style="white-space: nowrap;">
                🏛️ Departments
            </a>
            <a asp-controller="Admin" asp-action="Courses" 
               class="btn btn-sm @(currentAction.Contains("Course") ? "btn-primary" : "btn-neu")" style="white-space: nowrap;">
                📖 Courses
            </a>
            <a asp-controller="Admin" asp-action="Requests" 
               class="btn btn-sm @(currentAction.Contains("Request") || currentAction == "Exchanges" ? "btn-primary" : "btn-neu")" style="white-space: nowrap;">
                🔄 Requests & Trades
            </a>
            <a asp-controller="Admin" asp-action="Reports" 
               class="btn btn-sm @(currentAction.Contains("Report") ? "btn-primary" : "btn-neu")" style="white-space: nowrap;">
                ⚠️ Reports & Flags
            </a>
            <a asp-controller="Admin" asp-action="Reviews" 
               class="btn btn-sm @(currentAction.Contains("Review") ? "btn-primary" : "btn-neu")" style="white-space: nowrap;">
                ⭐ Reviews
            </a>
            <a asp-controller="Admin" asp-action="Analytics" 
               class="btn btn-sm @(currentAction == "Analytics" ? "btn-primary" : "btn-neu")" style="white-space: nowrap;">
                📈 Analytics & CSV
            </a>
            <a asp-controller="Admin" asp-action="AuditLogs" 
               class="btn btn-sm @(currentAction == "AuditLogs" ? "btn-primary" : "btn-neu")" style="white-space: nowrap;">
                📜 Security Logs
            </a>
            <a asp-controller="Admin" asp-action="Permissions" 
               class="btn btn-sm @(currentAction == "Permissions" ? "btn-primary" : "btn-neu")" style="white-space: nowrap;">
                🔑 Permissions
            </a>
        </div>
    </div>

    <!-- Admin Content Container -->
    <div class="admin-content-wrapper">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>Success:</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Error:</strong> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </div>
</div>

@await RenderSectionAsync("Scripts", required: false)

@{
    Layout = "_Layout";
}

<div class="container-fluid py-3">
    <div class="row">
        <!-- Sidebar Navigation -->
        <div class="col-lg-2 col-md-3 mb-4">
            <div class="card border-0 shadow-sm sticky-top" style="top: 80px; z-index: 10;">
                <div class="card-header bg-dark text-white fw-bold py-3 d-flex align-items-center gap-2">
                    <span class="fs-5">🛡️</span>
                    <span>Admin Panel</span>
                </div>
                <div class="list-group list-group-flush small">
                    <a asp-controller="Admin" asp-action="Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        📊 Dashboard
                    </a>
                    <a asp-controller="Admin" asp-action="Students" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString()?.StartsWith("Student") == true ? "active" : "")">
                        👨‍🎓 Students
                    </a>
                    <a asp-controller="Admin" asp-action="Books" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString()?.StartsWith("Book") == true ? "active" : "")">
                        📚 Book Moderation
                    </a>
                    <a asp-controller="Admin" asp-action="Categories" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString()?.Contains("Categor") == true ? "active" : "")">
                        🏷️ Categories
                    </a>
                    <a asp-controller="Admin" asp-action="Departments" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString()?.Contains("Department") == true ? "active" : "")">
                        🏛️ Departments
                    </a>
                    <a asp-controller="Admin" asp-action="Courses" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString()?.Contains("Course") == true ? "active" : "")">
                        📖 Courses
                    </a>
                    <a asp-controller="Admin" asp-action="Requests" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString()?.Contains("Request") == true || ViewContext.RouteData.Values["action"]?.ToString() == "Exchanges" ? "active" : "")">
                        🔄 Requests & Trades
                    </a>
                    <a asp-controller="Admin" asp-action="Reports" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString()?.Contains("Report") == true ? "active" : "")">
                        ⚠️ Reports & Flags
                    </a>
                    <a asp-controller="Admin" asp-action="Reviews" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString()?.Contains("Review") == true ? "active" : "")">
                        ⭐ Reviews
                    </a>
                    <a asp-controller="Admin" asp-action="Analytics" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString() == "Analytics" ? "active" : "")">
                        📈 Analytics & Export
                    </a>
                    <a asp-controller="Admin" asp-action="AuditLogs" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString() == "AuditLogs" ? "active" : "")">
                        📜 Audit Logs
                    </a>
                    <a asp-controller="Admin" asp-action="Permissions" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["action"]?.ToString() == "Permissions" ? "active" : "")">
                        🔑 Permissions
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Admin Content -->
        <div class="col-lg-10 col-md-9">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <strong>Success:</strong> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <strong>Error:</strong> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>
</div>

@await RenderSectionAsync("Scripts", required: false)

@model ErrorViewModel
@{
    ViewData["Title"] = "Application Error";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="mb-4">
            <span class="display-1 text-danger">⚠️</span>
        </div>
        <h1 class="h3 fw-bold text-danger mb-3">Something Went Wrong</h1>
        <p class="text-muted mb-4">An unexpected error occurred while processing your request. Please try again or return to the home page.</p>

        @if (Model.ShowRequestId)
        {
            <p class="small text-muted mb-4">
                <strong>Request Tracking ID:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-campus">Return to Home</a>
    </div>
</div>
